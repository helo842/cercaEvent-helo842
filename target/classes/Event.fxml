<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="700.0" prefWidth="450.0" spacing="15.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cercaevent.Controllers.EventController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Text text="Gestió d'esdeveniment" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
      <GridPane vgap="10.0">
        <columnConstraints>
          <ColumnConstraints prefWidth="150.0" /><ColumnConstraints prefWidth="250.0" />
        </columnConstraints>
         <children>
            <Text text="Títol (*)" GridPane.rowIndex="0" /><TextField fx:id="titol" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Text text="Ubicació (*)" GridPane.rowIndex="1" /><TextField fx:id="ubicacio" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Text text="Data (*)" GridPane.rowIndex="2" /><TextField fx:id="data_event" promptText="YYYY-MM-DD" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Text text="Hora (*)" GridPane.rowIndex="3" /><TextField fx:id="hora_event" promptText="HH:MM" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Text text="Aforament (*)" GridPane.rowIndex="4" /><TextField fx:id="aforament" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Text text="Places disponibles" GridPane.rowIndex="5" /><TextField fx:id="places_disponibles" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children><Text text="Categoria (*): " /><ComboBox fx:id="selector" onAction="#actualitzarEtiquetes" prefWidth="200.0" /></children>
      </HBox>

      <Text text="Camps segons la categoria seleccionada" style="-fx-font-size: 11px; -fx-fill: gray;" />
      <VBox spacing="10.0">
         <children>
            <HBox spacing="10.0"><Text fx:id="type1" prefWidth="100.0" text="..." /><TextField fx:id="password211" HBox.hgrow="ALWAYS" /></HBox>
            <HBox spacing="10.0"><Text fx:id="type2" prefWidth="100.0" text="..." /><TextField fx:id="password212" HBox.hgrow="ALWAYS" /></HBox>
            <HBox spacing="10.0"><Text fx:id="type3" prefWidth="100.0" text="..." /><TextField fx:id="password213" HBox.hgrow="ALWAYS" /></HBox>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="btnCreate" onAction="#hacerEvento" text="Guardar" />
            <Button fx:id="btnUpdate" onAction="#editarEvento" text="Actualitzar" />
            <Button fx:id="btnDelete" onAction="#eliminar" text="Eliminar" />
            <Button fx:id="btnInscriure" onAction="#inscriurem" text="Inscriure'm" />
            <Button fx:id="btnBaixa" onAction="#donarBaixa" text="Eliminar inscripció" />
            <Button fx:id="btnInscrits" onAction="#veureInscrits" text="Persones inscrites" />
         </children>
      </HBox>
      <Button maxWidth="Infinity" onAction="#tornar" text="Sortir" />
   </children>
</VBox>