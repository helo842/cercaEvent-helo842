<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cercaevent.Controllers.LoginController">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Login">
         <font>
            <Font size="19.0" />
         </font>
      </Text>
      <Button fx:id="ValidarUsuari1" onAction="#irRegistroPag" text="Registrar" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Usuari" />
      <TextField fx:id="usuari" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Contraseña" />
      <TextField fx:id="contraseña" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="console" />
      <TextField fx:id="msg" />
      <Button fx:id="ValidarUsuari" onAction="#validarUsuari" text="Login" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
