<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cercaevent.Controllers.CercaEventController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label text="Cerca Event"><font><Font size="26.0" /></font></Label>
            <Label text="Filtres" textFill="#666666"><font><Font size="14.0" /></font></Label>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Ubicacio" />
                  <TextField fx:id="Ubicacio" prefWidth="250.0" />
                  <Label text="Data" />
                  <DatePicker fx:id="Data" prefWidth="150.0" />
                  <CheckBox fx:id="Places" mnemonicParsing="false" text="Amb places disponibles" />
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="Aplicar" onAction="#aplicarFiltros" text="Aplicar filtres" />
                  <Button fx:id="Netejar" onAction="#netejarFiltros" text="Netejar" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="Tots" onAction="#carregarTots" text="Tots els Events" />
                  <Button fx:id="Meus" onAction="#carregarMeus" text="Els meus Events" />
                  <Button fx:id="Inscrits" onAction="#carregarInscrits" text="Events Inscrits" />
               </children>
               <VBox.margin><Insets top="10.0" /></VBox.margin>
            </HBox>
            <TableView fx:id="tableEvents" onMouseClicked="#clickTaula" prefHeight="400.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colTitol" prefWidth="200.0" text="Titol" />
                <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoria" />
                <TableColumn fx:id="colUbicacio" prefWidth="120.0" text="Ubicacio" />
                <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
                <TableColumn fx:id="colHora" prefWidth="90.0" text="Hora" />
                <TableColumn fx:id="colPlaces" prefWidth="100.0" text="Places" />
              </columns>
              <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>