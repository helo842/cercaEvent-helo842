<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cercaevent.Controllers.RegisterController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Register" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="name" />
      <TextField fx:id="name" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="surname" />
      <TextField fx:id="surname" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="nickname" />
      <TextField fx:id="nickname" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="email" />
      <TextField fx:id="email" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="password" />
      <TextField fx:id="password" />
      <GridPane>
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button fx:id="Sortir" mnemonicParsing="false" onAction="#Salir" prefHeight="30.0" prefWidth="100.0" text="Sortir" GridPane.columnIndex="1" />
            <Button fx:id="registrer" mnemonicParsing="false" onAction="#registrar" prefHeight="30.0" prefWidth="98.0" text="Registrar" />
         </children>
      </GridPane>
   </children>
</VBox>
